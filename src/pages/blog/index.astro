---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import landscapeCover from "../../assets/blog/ai-agent-tooling-landscape.png";
import tvSchweizCover from "../../assets/blog/tv-schweiz-altersschere.png";

const collectionPosts = (await getCollection("blog", ({ data }) => !data.draft)).map(p => ({
  ...p,
  href: `/blog/${p.id}/`,
}));

const manualPosts = [
  {
    id: "tv-schweiz-2025",
    href: "/blog/tv-schweiz-2025/",
    data: {
      title: "Claude kann jetzt Dashboards – und zwar in gut",
      description: "Claude kann jetzt Dashboards, und Tableau und Co. bekommen es schwer. Als Beispiel die Mediapulse-TV-Daten 2025, in weniger als einer Stunde zur Scroll-Story gemacht: 40 Jahre Sehdauer, der Fernsehtag in Viertelstunden, wer schaut und welche Sender den Bildschirm teilen. 15- bis 29-Jährige schauen 62 Prozent weniger als 2019, Personen ab 60 bleiben dabei. Mit einem 3D-Film zur Altersschere.",
      pubDate: new Date("2026-11-11"),
      readTime: 10 as number | null,
      category: "Datenstory",
      tags: ["Mediapulse", "TV-Nutzung", "Scrollytelling", "Datenvisualisierung", "3D"],
      series: null as string | null,
      cover: tvSchweizCover,
    },
  },
  {
    id: "ai-agent-tooling-landscape",
    href: "/blog/ai-agent-tooling-landscape/",
    data: {
      title: "AI Agent Tooling Landscape",
      description: "Rund 100 Tools zum Entwickeln mit KI-Agenten, sortiert in 14 Kategorien entlang des Stacks. Jede Kategorie gerankt nach Hacker-News- und Reddit-Diskussionen, ergänzt durch GitHub-Sternzahlen – mit Kosten, Lizenz und einem Link zu jedem Tool.",
      pubDate: new Date("2026-09-30"),
      readTime: null as number | null,
      category: "KI Tools",
      tags: ["AI Agents", "Claude Code", "Tooling", "Hacker News"],
      series: null as string | null,
      cover: landscapeCover,
    },
  },
];

const posts = [...manualPosts, ...collectionPosts].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const serien = [...new Set(posts.map((p) => p.data.series).filter(Boolean))]
  .map((name) => ({
    name: name as string,
    slug: (name as string).toLowerCase().replace(/[^a-z0-9]+/g, "-"),
    count: posts.filter((p) => p.data.series === name).length,
    latest: Math.max(
      ...posts.filter((p) => p.data.series === name).map((p) => p.data.pubDate.getTime())
    ),
  }))
  .sort((a, b) => b.latest - a.latest);

const dateFormat = new Intl.DateTimeFormat("de-CH", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout
  title="Blog – Datapeople"
  description="Einblicke, Tutorials und Neuigkeiten rund um Data Warehousing, Analytics und moderne Datenarchitekturen."
>
  <Navigation />
  <main id="main-content">
    <!-- Header -->
    <section class="px-6 pt-24 pb-16 md:pt-32 md:pb-20">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-4 font-sans text-sm uppercase tracking-[0.18em] text-[var(--color-ink-muted)]"
        >
          Schreibwerkstatt
        </p>
        <h1
          class="max-w-[24ch] font-serif leading-[1.05]"
          style="font-size: var(--text-display-xl);"
        >
          Einblicke, Tutorials und Neuigkeiten.
        </h1>
        <p
          class="mt-6 max-w-[60ch] font-sans text-lg leading-relaxed text-[var(--color-ink-muted)]"
        >
          Rund um Data Warehousing, Analytics und moderne Datenarchitekturen.
        </p>
      </div>
    </section>

    <!-- Post list -->
    <section class="px-6 pb-32">
      {
        serien.length > 0 && (
          <div
            class="mx-auto mb-2 flex max-w-5xl flex-wrap items-center gap-x-3 gap-y-3"
            role="tablist"
            aria-label="Nach Serie filtern"
          >
            <button
              type="button"
              data-series-tab
              data-series-slug="alle"
              aria-pressed="true"
              class="serie-tab"
            >
              Alle&nbsp;<span class="tabular-nums">({posts.length})</span>
            </button>
            {serien.map((s) => (
              <button
                type="button"
                data-series-tab
                data-series-slug={s.slug}
                aria-pressed="false"
                class="serie-tab"
              >
                {s.name}&nbsp;<span class="tabular-nums">({s.count})</span>
              </button>
            ))}
          </div>
        )
      }
      <ul class="mx-auto max-w-5xl border-b border-[var(--color-rule)] measure-none">
        {
          posts.map((post, i) => (
            <li
              data-series-item={post.data.series ? post.data.series.toLowerCase().replace(/[^a-z0-9]+/g, "-") : ""}
              class="group relative flex flex-col gap-8 border-t border-[var(--color-rule)] py-12 md:flex-row md:items-start md:gap-16 md:py-16"
            >
              <a
                href={post.href}
                data-blog-post-link
                data-post-slug={post.id}
                data-post-category={post.data.category}
                class="absolute inset-0 z-10"
                aria-label={`Artikel lesen: ${post.data.title}`}
              />

              <div class="order-2 flex-1 md:order-1">
                <div
                  class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2 font-sans text-sm text-[var(--color-ink-muted)]"
                >
                  <span class="text-[var(--color-accent)]">
                    {post.data.category}
                  </span>
                  <span aria-hidden="true">·</span>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {dateFormat.format(post.data.pubDate)}
                  </time>
                  {post.data.readTime && (
                    <>
                      <span aria-hidden="true">·</span>
                      <span>{post.data.readTime} min Lesezeit</span>
                    </>
                  )}
                  {post.data.series && (
                    <span class="rounded-full border border-[var(--color-accent)] px-3 py-0.5 text-[12px] uppercase tracking-[0.1em] text-[var(--color-accent)]">
                      Serie · {post.data.series}
                    </span>
                  )}
                </div>

                <h2
                  class="mb-4 font-serif leading-[1.1] text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-accent)]"
                  style="font-size: clamp(1.75rem, 2.5vw + 0.75rem, 2.5rem);"
                >
                  {post.data.title}
                </h2>

                <p class="mb-6 max-w-[60ch] font-sans text-[17px] leading-relaxed text-[var(--color-ink-muted)]">
                  {post.data.description}
                </p>

                <ul class="flex flex-wrap gap-x-4 gap-y-1 font-sans text-[12px] uppercase tracking-[0.1em] text-[var(--color-ink-muted)]">
                  {post.data.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>

              <div class="order-1 md:order-2 md:w-64 md:shrink-0 lg:w-80">
                <div class="overflow-hidden rounded-[var(--radius-card)] bg-[var(--color-surface)]">
                  <Image
                    src={post.data.thumb ?? post.data.cover}
                    alt=""
                    widths={[320, 480, 640]}
                    sizes="(min-width: 1024px) 320px, (min-width: 768px) 256px, 100vw"
                    class="aspect-[4/3] w-full object-cover opacity-80 grayscale transition-all duration-700 ease-out group-hover:scale-[1.02] group-hover:opacity-100 group-hover:grayscale-0"
                  />
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .serie-tab {
    padding-bottom: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-muted);
    border-bottom: 2px solid transparent;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .serie-tab:hover {
    color: var(--color-ink);
  }
  .serie-tab[aria-pressed="true"] {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>

<script is:inline>
  document.querySelectorAll("[data-series-tab]").forEach((tab) => {
    tab.addEventListener("click", () => {
      const slug = tab.getAttribute("data-series-slug");
      document.querySelectorAll("[data-series-tab]").forEach((t) => {
        t.setAttribute("aria-pressed", String(t === tab));
      });
      document.querySelectorAll("[data-series-item]").forEach((li) => {
        li.hidden = slug !== "alle" && li.getAttribute("data-series-item") !== slug;
      });
      window.umami?.track("blog_series_tab_selected", { series_slug: slug });
    });
  });

  document.querySelectorAll("[data-blog-post-link]").forEach((link) => {
    link.addEventListener("click", () => {
      window.umami?.track("blog_post_selected", {
        article_slug: link.getAttribute("data-post-slug"),
        article_category: link.getAttribute("data-post-category"),
        link_location: "blog_listing",
      });
    });
  });
</script>
