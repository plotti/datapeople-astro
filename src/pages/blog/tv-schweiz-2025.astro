        const series = [];
        REGS.forEach((r) => {
          ['home', 'priv'].forEach((kind) => {
            const name = kind === 'home' ? HOME[r] : 'Schweizer Private';
            const vals = rows.filter((d) => d.region === r && d.sender === name).map((d) => ({x: +d.jahr, y: +d.marktanteil_pct})).sort((a, b) => a.x - b.x);
            if (vals.length) series.push({name: kind === 'home' ? `${name} (${SHORT[r]})` : `Private ${SHORT[r]}`, region: r, kind, color: C(RC[r]), values: vals});
          });
        });
        if (!series.length) return;
        const all = series.flatMap((s) => s.values);
        const ext = d3.extent(all, (d) => d.x);
        const top = legend(ctx, [{label: 'SRG-Sender der Region', color: 'var(--color-fg)'}, {label: 'Schweizer Private', color: 'var(--color-fg)', dash: true}]) + 30;
        const right = d3.max(series, (s) => measure(ctx.svg, `${s.name} ${f1(s.values[s.values.length - 1].y)}`)) + 18;
        const F = frame(ctx, {x: d3.scaleLinear().domain(ext), yMax: d3.max(all, (d) => d.y) * 1.15, yFmt: f0, xTicks: yearTicks(ext[0], ext[1], ctx.w - 60 - right), xFmt: yr, right, top});
        refLineX(F, 2013);
        series.forEach((s, i) => drawLine(F, s.values, s.color, {animate: ctx.animate, delay: i * 150, dash: s.kind === 'priv'}));
        endLabels(F, series.map((s) => { const l = s.values[s.values.length - 1]; return {y: F.y(l.y), color: s.color, text: `${s.name} ${f1(l.y)}`}; }));
        const de = series.find((s) => s.kind === 'priv' && s.region === 'Deutschschweiz');
        if (de) {
          const a = de.values[0], b = de.values[de.values.length - 1];
          const mid = de.values.find((v) => v.x === 2010) || de.values[Math.floor(de.values.length / 2)];
          annot(ctx, F, {x: F.x(mid.x), y: F.y(mid.y), tx: F.x(mid.x) - 10, ty: F.y(mid.y) - 70, anchor: 'end', lines: ['Schweizer Private, Deutschschweiz', `${a.x}: ${f1(a.y)} % → ${b.x}: ${f1(b.y)} %`], delay: 1300});
        }
        hoverLines(ctx, F, series, Array.from(new Set(all.map((d) => d.x))).sort((a, b) => a - b), yr, pctFmt);
      }
    }
  };

  // Day curve: 96 quarter-hours starting at 02:00
  function tagChart(ctx, defs, mode) {
    const rows = ctx.data.tagesverlauf;
    const slots = Array.from(new Set(rows.map((r) => r.zeit)));
    const idx = new Map(slots.map((s, i) => [s, i]));
    const series = defs.map((d) => ({...d, values: rows.filter(d.filter).map((r) => ({x: idx.get(r.zeit), y: +r.rating_pct}))})).filter((s) => s.values.length);
    if (!series.length) return;
    const top = legend(ctx, series.map((s) => ({label: s.name, color: s.color}))) + 30;
    const every = ctx.w < 520 ? 6 : 4;
    const ticks = slots.map((s, i) => i).filter((i) => slots[i].endsWith(':00') && (+slots[i].slice(0, 2) - 2 + 24) % every === 0);
    const F = frame(ctx, {x: d3.scaleLinear().domain([0, slots.length - 1]), yMax: d3.max(series, (s) => d3.max(s.values, (v) => v.y)) * 1.3, yFmt: (v) => f0(v) + ' %', top, xTicks: ticks, xFmt: (i) => slots[i]});
    series.forEach((s, i) => drawLine(F, s.values, s.color, {animate: ctx.animate, delay: i * 250}));
    const sp = ctx.data.tag_spitze;
    if (mode === 'de') {
      const a = sp.find((r) => r.region === 'Deutschschweiz' && r.tage === 'Sa–So');
      const b = sp.find((r) => r.region === 'Deutschschweiz' && r.tage === 'Mo–Fr');
      if (a) { const x = F.x(idx.get(a.spitze_zeit)), y = F.y(+a.spitze_rating); annot(ctx, F, {x, y, tx: x - 14, ty: y - 46, anchor: 'end', lines: [`Wochenende ${a.spitze_zeit} Uhr`, `${f1(+a.spitze_rating)} % schauen gleichzeitig`], delay: 1100}); }
      if (b) { const x = F.x(idx.get(b.spitze_zeit)), y = F.y(+b.spitze_rating); annot(ctx, F, {x, y, tx: x - 34, ty: y + 70, anchor: 'end', lines: [`Mo–Fr ${b.spitze_zeit} Uhr`, `${f1(+b.spitze_rating)} %`], delay: 1400}); }
      if (b) { const x = F.x(idx.get(b.tief_zeit)), y = F.y(+b.tief_rating); annot(ctx, F, {x, y, tx: x + 6, ty: F.ih * 0.28, anchor: 'start', lines: [`Tiefpunkt ${b.tief_zeit} Uhr`, `${f1(+b.tief_rating)} %`], delay: 1700}); }
    } else {
      const peaks = sp.filter((r) => r.tage === 'Mo–So');
      if (peaks.length) {
        const m = peaks.reduce((a, b) => (+b.spitze_rating > +a.spitze_rating ? b : a));
        const x = F.x(idx.get(m.spitze_zeit)), y = F.y(+m.spitze_rating);
        annot(ctx, F, {x, y, tx: x - 14, ty: y - 46, anchor: 'end', lines: [`${m.region}, ${m.spitze_zeit} Uhr`, `Spitze: ${f1(+m.spitze_rating)} %`], delay: 1200});
      }
    }
    hoverLines(ctx, F, series, slots.map((s, i) => i), (i) => `${slots[i]} Uhr`, pctFmt);
  }

  // Age groups over the years: minutes, or indexed to the first year
  function alterTrendChart(ctx, indexed) {
    const rows = ctx.data.sehdauer_alter_trend;
    const ver = ctx.data.alter_veraenderung;
    const gruppen = Array.from(new Set(rows.map((r) => r.gruppe))).filter((g) => g !== 'Alle (3+)');
    const focus = {'60+': C(0), '15–29': C(4)};
    let series = gruppen.map((g) => {
      const v = rows.filter((r) => r.gruppe === g).map((r) => ({x: +r.jahr, y: +r.minuten})).sort((a, b) => a.x - b.x);
      const base = v.length ? v[0].y : 1;
      return {name: g, color: focus[g] || MUTED, focus: !!focus[g], values: indexed ? v.map((p) => ({x: p.x, y: Math.round((p.y / base) * 1000) / 10, raw: p.y})) : v};
    }).filter((s) => s.values.length);
    if (!series.length) return;
    const all = series.flatMap((s) => s.values);
    const ext = d3.extent(all, (d) => d.x);
    const lab = (s) => { const l = s.values[s.values.length - 1]; return `${s.name} ${indexed ? f0(l.y) : f0(l.y)}`; };
    const right = d3.max(series, (s) => measure(ctx.svg, lab(s))) + 18;
    const yMax = indexed ? Math.max(120, d3.max(all, (d) => d.y) * 1.1) : d3.max(all, (d) => d.y) * 1.25;
    const F = frame(ctx, {x: d3.scaleLinear().domain(ext), yMax, yFmt: f0, xTicks: d3.range(ext[0], ext[1] + 1, ctx.w < 420 ? 2 : 1), xFmt: yr, right});
    if (indexed) {
      F.gp.append('line').attr('class', 'tv-ref').attr('x1', 0).attr('x2', F.iw).attr('y1', F.y(100)).attr('y2', F.y(100));
      F.gp.append('text').attr('class', 'tv-lbl muted').attr('x', F.iw * 0.42).attr('y', F.y(100) - 6).text('2019 = 100');
    }
    series.sort((a, b) => a.focus - b.focus);
    series.forEach((s, i) => drawLine(F, s.values, s.color, {animate: ctx.animate, delay: s.focus ? 500 : i * 80, width: s.focus ? 3 : 1.5}));
    endLabels(F, series.map((s) => { const l = s.values[s.values.length - 1]; return {y: F.y(l.y), color: s.color, text: lab(s)}; }));
    const old = series.find((s) => s.name === '60+'), young = series.find((s) => s.name === '15–29');
    const vOld = ver.find((r) => r.gruppe === '60+'), vYoung = ver.find((r) => r.gruppe === '15–29');
    const fm = (v) => (Number.isInteger(v) ? f0(v) : f1(v));
    const sign = (v) => (v > 0 ? '+' : v < 0 ? '−' : '±') + f0(Math.abs(v));
    if (young && vYoung) {
      const p = young.values[young.values.length - 1];
      annot(ctx, F, {x: F.x(p.x), y: F.y(p.y), tx: F.x(p.x) - 16, ty: F.y(p.y) - (indexed ? 58 : 64), anchor: 'end', lines: [`15–29: ${sign(vYoung.veraenderung_pct)} % seit ${vYoung.von_jahr}`, `${fm(vYoung.von_minuten)} → ${fm(vYoung.bis_minuten)} Min. pro Tag`], delay: 1500});
    }
    if (old && vOld) {
      const p = old.values.find((v) => v.x === 2021) || old.values[Math.floor(old.values.length / 2)];
      annot(ctx, F, {x: F.x(p.x), y: F.y(p.y), tx: F.x(p.x) + 10, ty: F.y(p.y) - 52, anchor: 'start', lines: [`60+: ${sign(vOld.veraenderung_pct)} % seit ${vOld.von_jahr}`, `${fm(vOld.von_minuten)} → ${fm(vOld.bis_minuten)} Min. pro Tag`], delay: 1900});
    }
    const fmtY = indexed ? (v) => f1(v) : minFmt;
    hoverLines(ctx, F, series.slice().reverse(), Array.from(new Set(all.map((d) => d.x))).sort((a, b) => a - b), yr, fmtY);
  }

  // Pseudo-3D walls drawn in SVG: one wall per age group, years left to right, minutes as height
  function alter3d(ctx) {
    const rows = ctx.data.sehdauer_alter_trend.filter((r) => r.gruppe !== 'Alle (3+)');
    const groups = Array.from(new Set(rows.map((r) => r.gruppe)));
    const years = Array.from(new Set(rows.map((r) => +r.jahr))).sort((a, b) => a - b);
    if (!groups.length || years.length < 2) return;
    const val = new Map(rows.map((r) => [r.gruppe + '|' + r.jahr, +r.minuten]));
    const XS = 2, HS = 1 / 20, ZS = 1.7, D = 0.55;
    const walls = groups.map((g, i) => ({g, z: (groups.length - 1 - i) * ZS, v: years.map((y) => val.get(g + '|' + y) ?? 0),
      color: g === '60+' ? C(0) : g === '15–29' ? C(4) : MUTED, focus: g === '60+' || g === '15–29'}));
    const xMax = (years.length - 1) * XS, yMax = d3.max(walls, (w) => d3.max(w.v)) * HS, zMax = (groups.length - 1) * ZS + D;
    const center = [xMax / 2, yMax * 0.4, zMax / 2];
    const st = window.tv3d || (window.tv3d = {az: 0.72, el: 0.34});
    const top = legend(ctx, [{label: '60+', color: C(0), bar: true}, {label: '15–29', color: C(4), bar: true}, {label: 'übrige Altersgruppen', color: MUTED, bar: true}]) + 14;
    const root = ctx.g;
    root.append('rect').attr('x', 0).attr('y', top).attr('width', ctx.w).attr('height', ctx.h - top).attr('fill', 'transparent');
    const scene = root.append('g');
    const R = 36;
    function proj(p, az, el) {
      const x = p[0] - center[0], y = p[1] - center[1], z = p[2] - center[2];
      const ca = Math.cos(az), sa = Math.sin(az), ce = Math.cos(el), se = Math.sin(el);
      const x1 = x * ca - z * sa, z1 = x * sa + z * ca;
      const y2 = y * ce - z1 * se, z2 = y * se + z1 * ce;
      const d = R - z2;
      return [(x1 * R) / d, (-y2 * R) / d, d];
    }
    const corners = [];
    walls.forEach((w) => w.v.forEach((v, k) => { [[0, w.z], [0, w.z + D], [v * HS, w.z], [v * HS, w.z + D]].forEach(([y, z]) => corners.push([k * XS, y, z])); }));
    corners.push([0, 0, zMax + 1.2], [xMax, 0, zMax + 1.2], [-0.6, 180 * HS, -0.3]);
    function profile(w, sweep) {
      const pts = [], n = Math.floor(sweep);
      for (let k = 0; k <= n && k < w.v.length; k++) pts.push([k * XS, w.v[k] * HS]);
      if (sweep > n && n + 1 < w.v.length) { const f = sweep - n; pts.push([(n + f) * XS, (w.v[n] + (w.v[n + 1] - w.v[n]) * f) * HS]); }
      if (pts[pts.length - 1][0] < 0.12) pts.push([0.12, pts[0][1]]);
      return pts;
    }
    function draw(az, el, sweep) {
      scene.selectAll('*').remove();
      const pr = corners.map((p) => proj(p, az, el));
      const bx = d3.extent(pr, (q) => q[0]), by = d3.extent(pr, (q) => q[1]);
      const m = 18, lm = 58, availW = ctx.w - 2 * m - lm - 64, availH = ctx.h - top - 2 * m;
      const s = Math.min(availW / (bx[1] - bx[0]), availH / (by[1] - by[0]));
      const ox = m + lm + (availW - (bx[1] - bx[0]) * s) / 2 - bx[0] * s, oy = top + m + (availH - (by[1] - by[0]) * s) / 2 - by[0] * s;
      const P = (p) => { const q = proj(p, az, el); return [ox + q[0] * s, oy + q[1] * s, q[2]]; };
      const pathOf = (ps) => 'M' + ps.map((p) => { const q = P(p); return q[0].toFixed(1) + ',' + q[1].toFixed(1); }).join('L') + 'Z';
      const line = (a, b, cls) => { const p = P(a), q = P(b); scene.append('line').attr('class', cls).attr('x1', p[0]).attr('y1', p[1]).attr('x2', q[0]).attr('y2', q[1]); };
      // floor and minute rules
      const fl = scene.append('g');
      years.forEach((y, k) => { const p = P([k * XS, 0, -0.3]), q = P([k * XS, 0, zMax + 0.6]); fl.append('line').style('stroke', 'var(--cds-chart-grid)').attr('x1', p[0]).attr('y1', p[1]).attr('x2', q[0]).attr('y2', q[1]); });
      [ -0.3, zMax + 0.6].forEach((z) => { const p = P([-0.3, 0, z]), q = P([xMax + 0.3, 0, z]); fl.append('line').style('stroke', 'var(--cds-chart-grid)').attr('x1', p[0]).attr('y1', p[1]).attr('x2', q[0]).attr('y2', q[1]); });
      [60, 120, 180].forEach((mi) => {
        line([-0.3, mi * HS, -0.3], [xMax + 0.3, mi * HS, -0.3], 'tv-ref');
        const p = P([-0.4, mi * HS, -0.3]);
        scene.append('text').attr('class', 'tv-lbl muted').attr('x', p[0] - 4).attr('y', p[1]).attr('dy', '0.32em').attr('text-anchor', 'end').text(`${mi} Min.`);
      });
      // walls, far to near
      const labs = [];
      const order = walls.map((w) => ({w, d: P([xMax / 2, yMax / 3, w.z + D / 2])[2]})).sort((a, b) => b.d - a.d);
      order.forEach(({w}) => {
        const pts = profile(w, sweep);
        const xe = pts[pts.length - 1][0];
        const g = scene.append('g').style('opacity', w.focus ? 1 : 0.92);
        const faces = [];
        for (let k = 0; k < pts.length - 1; k++) {
          const a = pts[k], b = pts[k + 1];
          faces.push({ps: [[a[0], a[1], w.z + D], [b[0], b[1], w.z + D], [b[0], b[1], w.z], [a[0], a[1], w.z]], kind: 'top'});
        }
        faces.push({ps: [[0, 0, w.z], [0, pts[0][1], w.z], [0, pts[0][1], w.z + D], [0, 0, w.z + D]], kind: 'cap'});
        faces.push({ps: [[xe, 0, w.z], [xe, pts[pts.length - 1][1], w.z], [xe, pts[pts.length - 1][1], w.z + D], [xe, 0, w.z + D]], kind: 'cap'});
        faces.forEach((f) => { f.d = d3.mean(f.ps, (p) => P(p)[2]); });
        faces.sort((a, b) => b.d - a.d).forEach((f) => {
          g.append('path').attr('d', pathOf(f.ps)).style('fill', w.color).style('stroke', w.color).attr('stroke-width', 0.6)
            .style('filter', f.kind === 'top' ? 'brightness(1.22)' : 'brightness(0.72)');
        });
        const front = [[0, 0, w.z + D], ...pts.map((p) => [p[0], p[1], w.z + D]), [xe, 0, w.z + D]];
        const tops = pts.map((p) => P([p[0], p[1], w.z + D]));
        g.append('path').attr('d', pathOf(front)).style('fill', w.color).style('stroke', 'var(--color-panel)').attr('stroke-width', 0.8).attr('stroke-opacity', 0.6)
          .on('pointermove', (ev) => {
            const [mx] = d3.pointer(ev, ctx.svg.node());
            let k = 0, best = Infinity;
            tops.forEach((q, i) => { if (Math.abs(q[0] - mx) < best && i < w.v.length && pts[i][0] === i * XS) { best = Math.abs(q[0] - mx); k = i; } });
            showTip(ctx, `${w.g} Jahre · ${years[k]}`, [[w.color, 'Sehdauer', minFmt(w.v[k])]], tops[k][0], tops[k][1]);
          })
          .on('pointerleave', () => hideTip(ctx));
        const e = P([xe, pts[pts.length - 1][1], w.z + D / 2]);
        const k = Math.round(xe / XS);
        const shown = Math.abs(xe - k * XS) < 0.01 ? w.v[k] : pts[pts.length - 1][1] / HS;
        labs.push({x: e[0] + 6, y: e[1], focus: w.focus, text: `${w.g} · ${f0(shown)}`});
      });
      labs.sort((a, b) => a.y - b.y);
      for (let i = 1; i < labs.length; i++) {
        for (let j = 0; j < i; j++) if (Math.abs(labs[i].x - labs[j].x) < 70 && labs[i].y - labs[j].y < 14) labs[i].y = labs[j].y + 14;
      }
      labs.forEach((l) => scene.append('text').attr('class', l.focus ? 'tv-lbl' : 'tv-lbl muted').style('font-weight', l.focus ? 'var(--cds-font-weight-medium)' : null)
        .attr('x', l.x).attr('y', l.y).attr('dy', '0.32em').text(l.text));
      years.forEach((y, k) => {
        if (k * XS > sweep * XS + 0.01) return;
        if (ctx.w < 520 && k % 2 && k !== years.length - 1) return;
        const p = P([k * XS, 0, zMax + 1.1]);
        scene.append('text').attr('class', 'tv-lbl muted').attr('x', p[0]).attr('y', p[1]).attr('dy', '0.9em').attr('text-anchor', 'middle').text(String(y));
      });
    }
    // Drag with the mouse to turn the view
    root.on('pointerdown', (ev) => {
      if (ev.pointerType !== 'mouse') return;
      if (window.tv3dStop) window.tv3dStop();
      let lx = ev.clientX, ly = ev.clientY;
      const move = (e) => { st.az += (e.clientX - lx) * 0.008; st.el = Math.max(0.05, Math.min(1.1, st.el + (e.clientY - ly) * 0.005)); lx = e.clientX; ly = e.clientY; hideTip(ctx); draw(st.az, st.el, years.length - 1); };
      const up = () => { window.removeEventListener('pointermove', move); window.removeEventListener('pointerup', up); };
      window.addEventListener('pointermove', move);
      window.addEventListener('pointerup', up);
    }).style('cursor', 'grab');
    if (ctx.animate) {
      const ease = d3.easeCubicInOut, t0 = performance.now(), full = years.length - 1;
      let raf = 0;
      const stop = () => { cancelAnimationFrame(raf); window.tv3dStop = null; };
      window.tv3dStop = stop;
      const tick = (now) => {
        const t = (now - t0) / 1000;
        const a = ease(Math.min(1, t / 5.5));
        st.az = -1.15 + (0.72 + 1.15) * a;
        st.el = 0.2 + (0.34 - 0.2) * a;
        draw(st.az, st.el, full * d3.easeCubicOut(Math.max(0, Math.min(1, (t - 0.3) / 4))));
        if (t < 5.5) raf = requestAnimationFrame(tick); else stop();
      };
      raf = requestAnimationFrame(tick);
    } else {
      draw(st.az, st.el, years.length - 1);
    }
  }

  // Horizontal bars, optionally grouped
  function hbars(ctx, cats, vMax, top, subs) {
    const {svg, w, h} = ctx;
    const l = Math.ceil(d3.max(cats, (c) => measure(svg, c))) + 10;
    const r = 52;
    const M = {t: (top || 0) + 22, r, b: 8, l};
    const iw = Math.max(60, w - M.l - M.r), ih = Math.max(60, h - M.t - M.b);
    const y = d3.scaleBand().domain(cats).range([0, ih]).paddingInner(subs ? 0.25 : 0.3).paddingOuter(0.1);
    const sub = d3.scaleBand().domain(subs || ['_']).range([0, y.bandwidth()]).padding(0.08);
    const x = d3.scaleLinear().domain([0, vMax]).range([0, iw]);
    const gp = ctx.g.attr('transform', `translate(${M.l},${M.t})`);
    gp.append('g').attr('class', 'tv-xaxis').call(d3.axisLeft(y).tickSize(0).tickPadding(8)).call((g) => g.select('.domain').remove());
    const by = (c, s) => y(c) + sub(s || '_');
    const H = {x, y, sub, M, iw, ih, gp,
      yc: (c, s) => by(c, s) + sub.bandwidth() / 2,
      bar(c, from, v, color, i, tip, s) {
        const rect = gp.append('rect').attr('y', by(c, s)).attr('height', sub.bandwidth()).attr('x', x(from)).attr('rx', 2).style('fill', color)
          .on('pointerenter', () => showTip(ctx, c, tip, M.l + x(v), M.t + by(c, s)))
          .on('pointerleave', () => hideTip(ctx));
        if (ctx.animate) rect.attr('width', 0).transition().delay(i * 40).duration(700).ease(d3.easeCubicOut).attr('width', Math.max(0, x(v) - x(from)));
        else rect.attr('width', Math.max(0, x(v) - x(from)));
      },
      valueLabel(c, v, text, s) {
        const t = gp.append('text').attr('class', 'tv-lbl').attr('x', x(v) + 5).attr('y', H.yc(c, s)).attr('dy', '0.32em').text(text);
        if (ctx.animate) t.style('opacity', 0).transition().delay(700).duration(400).style('opacity', 1);
      }
    };
    return H;
  }

  dash.draw('stage', {
    mount(el) {
      const svg = d3.select(el).append('svg').attr('class', 'tv-svg').attr('role', 'img');
      const tip = d3.select(el).append('div').attr('class', 'tv-tip');
      return {svg, tip, last: null};
    },
    update(el, m) {
      const block = el.closest('.tv-scrolly');
      const want = block && block.dataset.view;
      const view = VIEWS[want] ? want : 'trend_de';
      const V = VIEWS[view];
      const sets = V.sources.map((id) => dash.data(id));
      const w = Math.max(260, el.clientWidth), h = Math.max(260, el.clientHeight || 400);
      m.svg.attr('width', w).attr('height', h).attr('viewBox', `0 0 ${w} ${h}`).attr('aria-label', V.label);
      if (window.tv3dStop) window.tv3dStop();
      m.svg.interrupt().selectAll('*').interrupt().remove();
      m.tip.style('opacity', 0);
      const msg = (s) => m.svg.append('text').attr('class', 'tv-msg').attr('x', w / 2).attr('y', h / 2).attr('text-anchor', 'middle').text(s);
      if (sets.some((s) => s.status === 'loading')) { msg('Lädt …'); return; }
      if (sets.some((s) => s.status !== 'ok' || s.data == null)) { msg('Konnte nicht geladen werden'); return; }
      const animate = !reduce && m.last !== view;
      m.last = view;
      const data = {};
      V.sources.forEach((id, i) => { data[id] = sets[i].data; });
      V.render({svg: m.svg, g: m.svg.append('g'), w, h, data, tip: m.tip, el, animate});
    }
  });
})();

</script>
