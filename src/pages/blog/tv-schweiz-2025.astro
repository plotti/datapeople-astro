          } else {
            set(b1, F.y(r.s), F.ih - F.y(r.s));
            set(b2, F.y(r.t), F.y(r.s) - F.y(r.t));
          }
          g.append('rect').attr('x', gx - xb.step() * xb.paddingInner() / 2).attr('width', xb.step()).attr('y', 0).attr('height', F.ih).attr('fill', 'transparent')
            .on('pointerenter', () => showTip(ctx, String(r.jahr), [[C(0), 'Sender', minFmt(r.s)], [C(4), 'Ohne Zuordnung', minFmt(r.n)], ['var(--color-fg-muted)', 'Total', minFmt(r.t)]], F.M.l + gx + bw / 2, F.M.t + F.y(r.t)))
            .on('pointerleave', () => hideTip(ctx));
        });
        const last = rows[rows.length - 1];
        const cx = xb(last.jahr) + bw / 2;
        annot(ctx, F, {x: cx, y: F.y(last.t - last.n / 2), tx: cx - bw, ty: F.y(last.t) - 54, anchor: 'end', lines: [`${last.jahr}: ${f0(last.p)} % ohne Sender`, `${f1(last.n)} von ${f1(last.t)} Minuten`], delay: 1400});
      }
    },
    zeitversetzt: {
      sources: ['zeitversetzt_trend', 'zeitversetzt_kennzahlen'],
      label: 'Liniendiagramm: zeitversetzte Nutzung 2013 bis 2025, Deutschschweiz',
      render(ctx) {
        const pts = ctx.data.zeitversetzt_trend.map((r) => ({x: +r.jahr, y: +r.minuten})).sort((a, b) => a.x - b.x);
        const k = ctx.data.zeitversetzt_kennzahlen[0];
        if (!pts.length || !k) return;
        const ext = d3.extent(pts, (d) => d.x);
        const F = frame(ctx, {x: d3.scaleLinear().domain(ext), yMax: d3.max(pts, (d) => d.y) * 1.35, yFmt: f0, xTicks: d3.range(ext[0], ext[1] + 1, ctx.w < 520 ? 4 : 2), xFmt: yr});
        drawArea(F, pts, C(1), ctx.animate);
        drawLine(F, pts, C(1), {animate: ctx.animate, width: 2.75});
        annot(ctx, F, {x: F.x(k.von_jahr), y: F.y(k.von_minuten), tx: F.x(k.von_jahr) + 6, ty: F.y(k.von_minuten) - 56, anchor: 'start', lines: [`${k.von_jahr}: ${f1(k.von_minuten)} Min.`], delay: 900});
        annot(ctx, F, {x: F.x(k.bis_jahr), y: F.y(k.bis_minuten), tx: F.x(k.bis_jahr) - 8, ty: F.y(k.bis_minuten) - 58, anchor: 'end', lines: [`${k.bis_jahr}: ${f1(k.bis_minuten)} Min.`, `${f1(k.faktor)}-mal so viel wie ${k.von_jahr}`], delay: 1500});
        hoverLines(ctx, F, [{name: 'Zeitversetzt', color: C(1), values: pts}], pts.map((d) => d.x), yr, minFmt);
      }
    },
    tag_de: {
      sources: ['tagesverlauf', 'tag_spitze'],
      label: 'Liniendiagramm: Rating im Tagesverlauf, Montag bis Freitag und Wochenende, Deutschschweiz',
      render(ctx) { tagChart(ctx, ['Mo–Fr', 'Sa–So'].map((t, i) => ({key: t, name: t === 'Mo–Fr' ? 'Montag–Freitag' : 'Samstag–Sonntag', color: C(i === 0 ? 0 : 4), filter: (r) => r.region === 'Deutschschweiz' && r.tage === t})), 'de'); }
    },
    tag_regionen: {
      sources: ['tagesverlauf', 'tag_spitze'],
      label: 'Liniendiagramm: Rating im Tagesverlauf nach Sprachregion',
      render(ctx) { tagChart(ctx, REGS.map((r) => ({key: r, name: r, color: C(RC[r]), filter: (d) => d.region === r && d.tage === 'Mo–So'})), 'reg'); }
    },
    alter_de: {
      sources: ['sehdauer_gruppen', 'alter_faktor'],
      label: 'Balkendiagramm: Sehdauer nach Altersgruppe, Deutschschweiz',
      render(ctx) {
        const rows = ctx.data.sehdauer_gruppen.filter((r) => r.region === 'Deutschschweiz' && r.merkmal === 'Alter').map((r) => ({g: r.gruppe, v: +r.minuten}));
        const avgRow = ctx.data.sehdauer_gruppen.find((r) => r.region === 'Deutschschweiz' && r.merkmal === 'Total');
        const fk = ctx.data.alter_faktor.find((r) => r.region === 'Deutschschweiz');
        if (!rows.length) return;
        const H = hbars(ctx, rows.map((r) => r.g), d3.max(rows, (r) => r.v), 0);
        rows.forEach((r, i) => H.bar(r.g, 0, r.v, r.g === '60+' || r.g === '15–29' ? C(0) : MUTED, i, [[C(0), r.g + ' Jahre', minFmt(r.v)]]));
        rows.forEach((r) => H.valueLabel(r.g, r.v, f1(r.v)));
        if (avgRow) {
          const ax = H.x(+avgRow.minuten);
          H.gp.append('line').attr('class', 'tv-ref').attr('x1', ax).attr('x2', ax).attr('y1', -6).attr('y2', H.ih);
          H.gp.append('text').attr('class', 'tv-lbl muted').attr('x', ax + 4).attr('y', -10).text(`Ø alle: ${f1(+avgRow.minuten)}`);
        }
        const jung = rows.find((r) => r.g === '15–29');
        if (jung && fk && fk.faktor != null) {
          const yy = H.yc('15–29');
          annot(ctx, H, {x: H.x(jung.v) + 34, y: yy, tx: H.x(jung.v) + 48, ty: yy - 6, anchor: 'start', noDot: true, lines: [`60+ schauen ${f1(fk.faktor)}-mal so lange`, 'wie 15- bis 29-Jährige'], delay: 1000});
        }
      }
    },
    alter_trend: {
      sources: ['sehdauer_alter_trend', 'alter_veraenderung'],
      label: 'Liniendiagramm: Sehdauer nach Altersgruppe 2019 bis 2025, Deutschschweiz',
      render(ctx) { alterTrendChart(ctx, false); }
    },
    alter_index: {
      sources: ['sehdauer_alter_trend', 'alter_veraenderung'],
      label: 'Liniendiagramm: Veränderung der Sehdauer seit 2019 nach Altersgruppe, Index 2019 = 100',
      render(ctx) { alterTrendChart(ctx, true); }
    },
    alter_3d: {
      sources: ['sehdauer_alter_trend'],
      label: '3D-Ansicht: Sehdauer der sechs Altersgruppen von 2019 bis 2025 als hintereinander stehende Wände, Deutschschweiz',
      render(ctx) { alter3d(ctx); }
    },
    alter_regionen: {
      sources: ['sehdauer_gruppen'],
      label: 'Gruppierte Balken: Sehdauer nach Altersgruppe in den drei Sprachregionen',
      render(ctx) {
        const rows = ctx.data.sehdauer_gruppen.filter((r) => r.merkmal === 'Alter');
        if (!rows.length) return;
        const groups = Array.from(new Set(rows.map((r) => r.gruppe)));
        const top = legend(ctx, REGS.map((r) => ({label: r, color: C(RC[r]), bar: true}))) + 22;
        const H = hbars(ctx, groups, d3.max(rows, (r) => +r.minuten), top, REGS);
        let i = 0;
        rows.forEach((r) => { H.bar(r.gruppe, 0, +r.minuten, C(RC[r.region]), i++, [[C(RC[r.region]), r.region, minFmt(+r.minuten)]], r.region); });
        if (H.sub.bandwidth() >= 9) rows.forEach((r) => H.valueLabel(r.gruppe, +r.minuten, f0(+r.minuten), r.region));
        const m = rows.reduce((a, b) => (+b.minuten > +a.minuten ? b : a));
        const yy = H.yc(m.gruppe, m.region);
        annot(ctx, H, {x: H.x(+m.minuten), y: yy, tx: H.iw, ty: H.y(groups[Math.max(0, groups.length - 3)]), anchor: 'end', lines: [`${f1(+m.minuten)} Minuten am Tag`, `${m.gruppe}, ${m.region}`], delay: 1200});
      }
    },
    sender_2025: {
      sources: ['marktanteile_de'],
      label: 'Balkendiagramm: Marktanteile der Sender in der Deutschschweiz 2025',
      render(ctx) {
        const all = ctx.data.marktanteile_de;
        const lastYear = d3.max(all, (r) => +r.jahr);
        const skip = new Set(['SRF', 'SRG SSR', 'andere SRG SSR']);
        const rows = all.filter((r) => +r.jahr === lastYear && !skip.has(r.sender) && +r.marktanteil_pct >= 0.8).map((r) => ({g: r.sender, v: +r.marktanteil_pct})).sort((a, b) => b.v - a.v);
        const srf = all.find((r) => +r.jahr === lastYear && r.sender === 'SRF');
        if (!rows.length) return;
        const label = (g) => (g === 'Schweizer Private' ? 'Schweizer Private (alle)' : g);
        const H = hbars(ctx, rows.map((r) => label(r.g)), d3.max(rows, (r) => r.v) * 1.15, 0);
        const col = (g) => (/^SRF/.test(g) ? C(0) : g === 'Schweizer Private' ? C(1) : MUTED);
        rows.forEach((r, i) => H.bar(label(r.g), 0, r.v, col(r.g), i, [[col(r.g), r.g, pctFmt(r.v)]]));
        rows.forEach((r) => H.valueLabel(label(r.g), r.v, f1(r.v) + ' %'));
        if (srf) {
          const top = rows.find((r) => /^SRF/.test(r.g));
          if (top) {
            const yy = H.yc(label(top.g));
            const lx = H.x(top.v) + measure(ctx.svg, f1(top.v) + ' %') + 10;
            annot(ctx, H, {x: lx, y: yy, tx: H.iw + H.M.r - 6, ty: H.ih * 0.62, anchor: 'end', noDot: true, lines: ['SRF-Sender zusammen', `${f1(+srf.marktanteil_pct)} % der TV-Zeit`], delay: 1000});
          }
        }
      }
    },
    heimsender: {
      sources: ['heimsender_anteil'],
      label: 'Liniendiagramm: Marktanteil der SRG-Sender und der Schweizer Privaten je Sprachregion, 1995 bis 2025',
      render(ctx) {
