<script is:inline>

// Small stand-in for the dashboard runtime: loads the CSV files, works out calculations
// and redraws every [data-draw] element when data arrives or its width changes.
(function () {
  const BASE = '/tv-schweiz/data/';
  const FILES = {tv_minuten_trend: 'tv_minuten_trend.csv', zeitversetzt_trend: 'zeitversetzt_trend.csv', tagesverlauf: 'tagesverlauf.csv',
    sehdauer_gruppen: 'sehdauer_gruppen.csv', marktanteile_de: 'marktanteile_deutschschweiz.csv', heimsender_anteil: 'heimsender_anteil.csv',
    tv_set_komponenten: 'tv_set_komponenten.csv', sehdauer_alter_trend: 'sehdauer_alter_trend.csv'};
  const store = {}, calcs = {}, draws = {}, listeners = [];
  let scheduled = false;
  function load(id) {
    if (store[id]) return;
    store[id] = {status: 'loading', data: []};
    d3.csv(BASE + FILES[id]).then((rows) => { store[id] = {status: 'ok', data: rows}; Object.values(calcs).forEach((c) => { c.cache = undefined; }); schedule(); })
      .catch((e) => { store[id] = {status: 'error', data: [], message: String(e)}; schedule(); });
  }
  function data(id) {
    if (FILES[id]) { load(id); return store[id]; }
    const c = calcs[id];
    if (!c) return {status: 'missing', data: null};
    const ins = c.inputs.map(data);
    if (ins.some((s) => s.status === 'loading')) return {status: 'loading', data: null};
    if (ins.some((s) => s.status !== 'ok')) return {status: 'error', data: null};
    if (c.cache === undefined) { try { c.cache = c.fn(...ins.map((s) => s.data)); } catch (e) { console.error(e); c.cache = null; } }
    return {status: c.cache == null ? 'error' : 'ok', data: c.cache};
  }
  function runEl(name, el) {
    const d = draws[name];
    if (!d) return;
    try {
      if (typeof d === 'function') d(el);
      else { if (!el.__made) { el.replaceChildren(); el.__made = d.mount ? d.mount(el) : {}; } d.update && d.update(el, el.__made); }
    } catch (e) { console.error(e); }
  }
  function run(name) { document.querySelectorAll(`[data-draw="${name}"]`).forEach((el) => runEl(name, el)); }
  function runAll() { scheduled = false; listeners.forEach((f) => { try { f(); } catch (e) { console.error(e); } }); Object.keys(draws).forEach(run); }
  function schedule() { if (!scheduled) { scheduled = true; requestAnimationFrame(runAll); } }
  const widths = new WeakMap();
  const ro = new ResizeObserver((entries) => entries.forEach((en) => {
    const el = en.target, w = Math.round(en.contentRect.width), h = Math.round(en.contentRect.height);
    const prev = widths.get(el);
    widths.set(el, w + 'x' + h);
    if (prev && prev !== w + 'x' + h) runEl(el.dataset.draw, el);
  }));
  window.dash = {
    colors: ['#2d6a4f', '#52b788', '#a3b43c', '#7a5c3e', '#d99a2b', '#2b8c8c', '#8a8f85', '#a8415b'],
    data, calc(id, o) { calcs[id] = o; },
    loader() {}, onData(fn) { listeners.push(fn); },
    draw(name, fn) {
      if (!fn) { run(name); return; }
      draws[name] = fn;
      document.querySelectorAll(`[data-draw="${name}"]`).forEach((el) => ro.observe(el));
      schedule();
    },
    drawIn(root, name) { root.querySelectorAll(`[data-draw="${name}"]`).forEach((el) => runEl(name, el)); },
    refresh() {}, params() { return {}; }, setParams() {}, resetParams() {}, setLink() {}
  };
})();


// Calculations worked out from the attached Mediapulse tables
dash.calc('trend_kennzahlen', {
  inputs: ['tv_minuten_trend'],
  title: 'Höchststand und Rückgang · Deutschschweiz',
  description: 'Jahr mit der höchsten Sehdauer und Rückgang bis zum letzten Jahr in Prozent.',
  fn: (trend) => {
    const de = trend.filter((r) => r.region === 'Deutschschweiz').map((r) => ({jahr: +r.jahr, min: +r.minuten}));
    if (!de.length) return [];
    const peak = de.reduce((a, b) => (b.min > a.min ? b : a));
    const last = de.reduce((a, b) => (b.jahr > a.jahr ? b : a));
    return [{peak_jahr: peak.jahr, peak_minuten: peak.min, letztes_jahr: last.jahr, letzte_minuten: last.min, rueckgang_pct: Math.round((1 - last.min / peak.min) * 100)}];
  }
});

dash.calc('tv_set_anteile', {
  inputs: ['tv_set_komponenten'],
  title: 'TV-Gerät: mit und ohne Senderzuordnung',
  description: 'Minuten mit Senderzuordnung (Total minus Playback/DVD/Games und nicht identifizierte Audios) und Anteil ohne Zuordnung.',
  fn: (komponenten) => komponenten.map((r) => {
    const total = +r.total_minuten;
    const ohne = +r.playback_dvd_games_minuten + +r.nicht_identifiziert_minuten;
    return {region: r.region, jahr: r.jahr, total_minuten: total, sender_minuten: Math.round((total - ohne) * 10) / 10, nicht_sender_minuten: Math.round(ohne * 10) / 10, nicht_sender_pct: Math.round((ohne / total) * 100)};
  })
});

dash.calc('zeitversetzt_kennzahlen', {
  inputs: ['zeitversetzt_trend'],
  title: 'Zeitversetzt: erstes und letztes Jahr',
  description: 'Minuten zeitversetzter Nutzung im ersten und letzten Jahr und das Verhältnis der beiden.',
  fn: (zeitversetzt) => {
    const s = zeitversetzt.map((r) => ({jahr: +r.jahr, min: +r.minuten})).sort((a, b) => a.jahr - b.jahr);
    if (!s.length) return [];
    const a = s[0], b = s[s.length - 1];
    return [{von_jahr: a.jahr, von_minuten: a.min, bis_jahr: b.jahr, bis_minuten: b.min, faktor: Math.round((b.min / a.min) * 10) / 10}];
  }
});

dash.calc('tag_spitze', {
  inputs: ['tagesverlauf'],
  title: 'Spitze und Tiefpunkt im Tagesverlauf',
  description: 'Viertelstunde mit dem höchsten und tiefsten Rating je Region und Tagesgruppe.',
  fn: (verlauf) => {
    const groups = new Map();
    verlauf.forEach((r) => {
      const k = r.region + '|' + r.tage;
      if (!groups.has(k)) groups.set(k, []);
      groups.get(k).push(r);
    });
    return Array.from(groups.values()).map((rows) => {
      const hi = rows.reduce((a, b) => (+b.rating_pct > +a.rating_pct ? b : a));
      const lo = rows.reduce((a, b) => (+b.rating_pct < +a.rating_pct ? b : a));
      return {region: hi.region, tage: hi.tage, spitze_zeit: hi.zeit, spitze_rating: +hi.rating_pct, tief_zeit: lo.zeit, tief_rating: +lo.rating_pct};
    });
  }
});

dash.calc('alter_veraenderung', {
  inputs: ['sehdauer_alter_trend'],
  title: 'Veränderung der Sehdauer seit 2019 nach Alter',
  description: 'Prozentuale Veränderung der Minuten pro Tag vom ersten zum letzten Jahr, je Altersgruppe (Deutschschweiz).',
  fn: (alterTrend) => {
    const gruppen = Array.from(new Set(alterTrend.map((r) => r.gruppe)));
    return gruppen.map((gruppe) => {
      const s = alterTrend.filter((r) => r.gruppe === gruppe).map((r) => ({jahr: +r.jahr, min: +r.minuten})).sort((a, b) => a.jahr - b.jahr);
      const a = s[0], b = s[s.length - 1];
      return {gruppe, von_jahr: a.jahr, von_minuten: a.min, bis_jahr: b.jahr, bis_minuten: b.min, veraenderung_pct: Math.round((b.min / a.min - 1) * 100)};
    });
  }
});

dash.calc('alter_faktor', {
  inputs: ['sehdauer_gruppen'],
  title: 'Sehdauer 60+ im Verhältnis zu 15–29',
  description: 'Wie viel Mal länger Personen ab 60 fernsehen als 15- bis 29-Jährige, je Region.',
  fn: (gruppen) => {
    const regions = Array.from(new Set(gruppen.map((r) => r.region)));
    return regions.map((region) => {
      const alt = gruppen.find((r) => r.region === region && r.gruppe === '60+');
      const jung = gruppen.find((r) => r.region === region && r.gruppe === '15–29');
      return {region, faktor: alt && jung ? Math.round((+alt.minuten / +jung.minuten) * 10) / 10 : null};
    });
  }
});


// Shared helpers
(function () {
  const loc = d3.formatLocale({decimal: '.', thousands: '’', grouping: [3], currency: ['CHF ', '']});
  window.tvFmt = {f0: loc.format('.0f'), f1: loc.format('.1f'), f2: loc.format('.2f')};
  window.tvState = window.tvState || {view: 'trend_de'};
})();


// Numbers inside the text
dash.draw('num', (el) => {
  const {f0, f1, f2} = window.tvFmt;
  const d = dash.data(el.dataset.source);
  if (d.status !== 'ok' || !d.data) { el.textContent = '—'; return; }
  const rows = Array.isArray(d.data) ? d.data : [d.data];
  let row;
  if (el.dataset.where) {
    const conds = el.dataset.where.split('&').map((s) => s.split('=').map(decodeURIComponent));
    row = rows.find((r) => conds.every(([k, v]) => String(r[k]) === v));
  } else {
    row = rows[+(el.dataset.row || 0)];
  }
  const v = row ? row[el.dataset.field] : null;
  if (v == null || v === '') { el.textContent = '—'; return; }
  const f = el.dataset.fmt;
  el.textContent = f === 'signed' ? (+v > 0 ? '+' : +v < 0 ? '−' : '±') + f0(Math.abs(+v)) : f === 'raw' ? String(v) : f === 'int' ? f0(+v) : f === 'd2' ? f2(+v) : f1(+v);
});


// Scroll steps: which chapter is in view decides the chart
(function () {
  const steps = Array.from(document.querySelectorAll('.tv-step[data-view]'));
  if (!steps.length || !('IntersectionObserver' in window)) return;
  const root = document.querySelector('.tv');
  const narrow = root && root.clientWidth < 720;
  const setView = (view, stepEl) => {
    const block = stepEl.closest('.tv-scrolly');
    if (!block) return;
    block.querySelectorAll('.tv-step').forEach((s) => s.classList.toggle('is-active', s === stepEl));
    block.querySelectorAll('.tv-ctitle').forEach((t) => { t.hidden = t.dataset.for !== view; });
    if (block.dataset.view !== view) {
      block.dataset.view = view;
      if (dash.drawIn) dash.drawIn(block, 'stage'); else dash.draw('stage');
    }
  };
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) setView(e.target.dataset.view, e.target); });
  }, {root: null, rootMargin: narrow ? '-74% 0px -22% 0px' : '-46% 0px -50% 0px', threshold: 0});
  steps.forEach((s) => io.observe(s));
})();


// The chart that stays in view
(function () {
  const {f0, f1} = window.tvFmt;
  const reduce = !window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
  const C = (i) => dash.colors[i % dash.colors.length];
  const MUTED = 'var(--cds-chart-muted)';
  const REGS = ['Deutschschweiz', 'Suisse romande', 'Svizzera italiana'];
  const RC = {'Deutschschweiz': 0, 'Suisse romande': 1, 'Svizzera italiana': 2};
  const HOME = {'Deutschschweiz': 'SRF', 'Suisse romande': 'RTS', 'Svizzera italiana': 'RSI'};
  const SHORT = {'Deutschschweiz': 'DE', 'Suisse romande': 'FR', 'Svizzera italiana': 'IT'};

  function measure(svg, str, cls) {
    const t = svg.append('text').attr('class', cls || 'tv-measure').text(str);
    const w = t.node().getComputedTextLength() || str.length * 7;
    t.remove();
    return w;
  }
  function yearTicks(a, b, iw) {
    const step = iw < 300 ? 10 : 5;
    const s = Math.ceil(a / step) * step;
    return d3.range(s, b + 1, step);
  }
  function frame(ctx, o) {
    const {svg, w, h} = ctx;
    const y = d3.scaleLinear().domain([0, o.yMax]).nice();
    const yt = y.ticks(h < 380 ? 4 : 5);
    const l = Math.ceil(d3.max(yt, (t) => measure(svg, o.yFmt(t)))) + 8;
    const r = o.right || 12;
    const M = {t: o.top || 30, r, b: 24, l};
    const iw = Math.max(60, w - M.l - M.r), ih = Math.max(60, h - M.t - M.b);
    const x = o.x.range([0, iw]);
    y.range([ih, 0]);
    const gp = ctx.g.attr('transform', `translate(${M.l},${M.t})`);
    gp.append('g').attr('class', 'tv-grid').call(d3.axisLeft(y).tickValues(yt).tickSize(-iw).tickFormat(o.yFmt)).call((g) => g.select('.domain').remove());
    const xa = d3.axisBottom(x).tickSizeOuter(0);
    if (o.xTicks) xa.tickValues(o.xTicks);
    if (o.xFmt) xa.tickFormat(o.xFmt);
    gp.append('g').attr('class', 'tv-xaxis').attr('transform', `translate(0,${ih})`).call(xa);
    return {x, y, M, iw, ih, gp};
  }
  function drawLine(F, pts, color, o) {
    o = o || {};
    const p = F.gp.append('path').datum(pts).attr('fill', 'none').style('stroke', color)
      .attr('stroke-width', o.width || 2.25).attr('stroke-linejoin', 'round').attr('stroke-linecap', 'round')
      .attr('d', d3.line().defined((d) => d.y != null && !isNaN(d.y)).x((d) => F.x(d.x)).y((d) => F.y(d.y)));
    if (o.dash) p.attr('stroke-dasharray', '5 4');
    if (o.animate) {
      if (o.dash) {
        p.style('opacity', 0).transition().delay(o.delay || 0).duration(700).style('opacity', 1);
      } else {
        const L = p.node().getTotalLength();
        p.attr('stroke-dasharray', `${L} ${L}`).attr('stroke-dashoffset', L)
          .transition().delay(o.delay || 0).duration(1300).ease(d3.easeCubicOut).attr('stroke-dashoffset', 0)
          .on('end', () => p.attr('stroke-dasharray', null));
      }
    }
    return p;
  }
  function drawArea(F, pts, color, animate) {
    const a = F.gp.append('path').datum(pts).style('fill', color).style('fill-opacity', 0.12)
      .attr('d', d3.area().x((d) => F.x(d.x)).y0(F.ih).y1((d) => F.y(d.y)));
    if (animate) a.style('opacity', 0).transition().delay(500).duration(900).style('opacity', 1);
  }
  // An annotation: a ringed point, a leader line and a short text block
  function annot(ctx, F, o) {
    const a = F.gp.append('g').attr('class', 'tv-annot');
    const t = a.append('text');
    (o.lines || []).forEach((s, i) => t.append('tspan').attr('class', i === 0 ? 'hd' : null).attr('x', 0).attr('dy', i === 0 ? 0 : 15).text(s));
    let bw = 0;
    t.selectAll('tspan').each(function () { bw = Math.max(bw, this.getComputedTextLength()); });
    const bh = 15 * (o.lines.length - 1);
    let left = o.anchor === 'end' ? o.tx - bw : o.anchor === 'middle' ? o.tx - bw / 2 : o.tx;
    left = Math.max(-F.M.l + 4, Math.min(left, F.iw + F.M.r - bw - 4));
    let top = Math.max(-F.M.t + 12, Math.min(o.ty, F.ih - bh - 2));
    t.attr('transform', `translate(${left},${top})`);
    const lx = Math.max(left, Math.min(o.x, left + bw));
    const below = top > o.y;
    const ly = below ? top - 12 : top + bh + 6;
    if (Math.hypot(lx - o.x, ly - o.y) > 10) a.insert('line', 'text').attr('x1', o.x).attr('y1', o.y).attr('x2', lx).attr('y2', ly);
    if (!o.noDot) a.append('circle').attr('cx', o.x).attr('cy', o.y).attr('r', 4.5);
    if (ctx.animate) a.style('opacity', 0).transition().delay(o.delay == null ? 1100 : o.delay).duration(500).style('opacity', 1);
  }
  function refLineX(F, xv, label) {
    const g = F.gp.append('g');
    g.append('line').attr('class', 'tv-ref').attr('x1', F.x(xv)).attr('x2', F.x(xv)).attr('y1', 0).attr('y2', F.ih);
    if (label) g.append('text').attr('class', 'tv-lbl muted').attr('x', F.x(xv) + 5).attr('y', F.ih - 8).text(label);
  }
  function legend(ctx, items) {
    const g = ctx.svg.append('g').attr('transform', 'translate(0,10)');
    let x = 0, y = 0;
    items.forEach((it) => {
      const w = measure(ctx.svg, it.label) + 30;
      if (x + w > ctx.w && x > 0) { x = 0; y += 16; }
      const row = g.append('g').attr('transform', `translate(${x},${y})`);
      const sw = row.append('line').attr('x1', 0).attr('x2', 16).attr('y1', 0).attr('y2', 0).style('stroke', it.color).attr('stroke-width', it.bar ? 8 : 2.5);
      if (it.dash) sw.attr('stroke-dasharray', '4 3');
      row.append('text').attr('class', 'tv-lbl').attr('x', 21).attr('dy', '0.32em').text(it.label);
      x += w;
    });
    return y + 16;
  }
  function endLabels(F, items) {
    items.sort((a, b) => a.y - b.y);
    for (let i = 1; i < items.length; i++) if (items[i].y - items[i - 1].y < 14) items[i].y = items[i - 1].y + 14;
    const over = items.length ? items[items.length - 1].y - F.ih : 0;
    if (over > 0) items.forEach((it) => { it.y -= over; });
    items.forEach((it) => {
      F.gp.append('circle').attr('cx', F.iw + 6).attr('cy', it.y).attr('r', 3).style('fill', it.color);
      F.gp.append('text').attr('class', 'tv-lbl').attr('x', F.iw + 12).attr('y', it.y).attr('dy', '0.32em').text(it.text);
    });
  }
  function showTip(ctx, title, rows, px, py) {
    const t = ctx.tip;
    t.selectAll('*').remove();
    t.append('div').attr('class', 'tv-tip-title').text(title);
    rows.forEach(([c, n, v]) => {
      const r = t.append('div').attr('class', 'tv-tip-row');
      r.append('i').style('background', c);
      r.append('span').text(n);
      r.append('b').text(v);
    });
    const tw = t.node().offsetWidth, th = t.node().offsetHeight;
    let left = px + 14;
    if (left + tw > ctx.w - 2) left = px - tw - 14;
    left = Math.max(2, left);
    let top = py - th - 12;
    if (top < 2) top = Math.min(py + 14, ctx.h - th - 2);
    t.style('left', left + 'px').style('top', top + 'px').style('opacity', 1);
  }
  function hideTip(ctx) { ctx.tip.style('opacity', 0); }
  function hoverLines(ctx, F, series, xVals, fmtX, fmtY) {
    const rule = F.gp.append('line').attr('class', 'tv-rule').attr('y1', 0).attr('y2', F.ih).style('opacity', 0);
    const dots = F.gp.append('g');
    F.gp.append('rect').attr('width', F.iw).attr('height', F.ih).attr('fill', 'transparent')
      .on('pointermove', (ev) => {
        const [px] = d3.pointer(ev);
        const xv = F.x.invert(px);
        const near = xVals.reduce((a, b) => (Math.abs(b - xv) < Math.abs(a - xv) ? b : a));
        const rows = series.map((s) => ({s, p: s.values.find((v) => v.x === near)})).filter((r) => r.p && r.p.y != null && !isNaN(r.p.y));
        if (!rows.length) return;
        rule.attr('x1', F.x(near)).attr('x2', F.x(near)).style('opacity', 1);
        dots.selectAll('circle').data(rows).join('circle').attr('r', 4).attr('cx', F.x(near)).attr('cy', (r) => F.y(r.p.y))
          .style('fill', (r) => r.s.color).style('stroke', 'var(--color-panel)').attr('stroke-width', 2);
        showTip(ctx, fmtX(near), rows.map((r) => [r.s.color, r.s.name, fmtY(r.p.y)]), F.M.l + F.x(near), F.M.t + d3.min(rows, (r) => F.y(r.p.y)));
      })
      .on('pointerleave', () => { rule.style('opacity', 0); dots.selectAll('*').remove(); hideTip(ctx); });
  }
  const yr = d3.format('d');
  const minFmt = (v) => f1(v) + ' Min.';
  const pctFmt = (v) => f1(v) + ' %';

  const VIEWS = {
    trend_de: {
      sources: ['tv_minuten_trend', 'trend_kennzahlen'],
      label: 'Liniendiagramm: Sehdauer in der Deutschschweiz von 1985 bis 2025',
      render(ctx) {
        const pts = ctx.data.tv_minuten_trend.filter((r) => r.region === 'Deutschschweiz').map((r) => ({x: +r.jahr, y: +r.minuten})).sort((a, b) => a.x - b.x);
        const k = ctx.data.trend_kennzahlen[0];
        if (!pts.length || !k) return;
        const ext = d3.extent(pts, (d) => d.x);
        const iwGuess = ctx.w - 60;
        const F = frame(ctx, {x: d3.scaleLinear().domain(ext), yMax: d3.max(pts, (d) => d.y) * 1.4, yFmt: f0, xTicks: yearTicks(ext[0], ext[1], iwGuess), xFmt: yr});
        refLineX(F, 2013, 'neues Messsystem');
        drawArea(F, pts, C(0), ctx.animate);
        drawLine(F, pts, C(0), {animate: ctx.animate, width: 2.75});
        const px = F.x(k.peak_jahr), py = F.y(k.peak_minuten);
        annot(ctx, F, {x: px, y: py, tx: px - 10, ty: py - 58, anchor: 'end', lines: [`${k.peak_jahr}: Höchststand`, `${f1(k.peak_minuten)} Minuten pro Tag`], delay: 900});
        const p20 = pts.find((d) => d.x === 2020), p19 = pts.find((d) => d.x === 2019);
        if (p20 && p19) annot(ctx, F, {x: F.x(2020), y: F.y(p20.y), tx: F.x(2020) - 8, ty: F.y(p20.y) - 64, anchor: 'end', lines: ['2020: Corona-Jahr', `${p20.y - p19.y >= 0 ? '+' : '−'}${f1(Math.abs(p20.y - p19.y))} Min. ggü. 2019`], delay: 1300});
        const lx = F.x(k.letztes_jahr), ly = F.y(k.letzte_minuten);
        annot(ctx, F, {x: lx, y: ly, tx: lx, ty: ly + 40, anchor: 'end', lines: [`${k.letztes_jahr}: ${f1(k.letzte_minuten)} Min.`, `−${k.rueckgang_pct} % seit ${k.peak_jahr}`], delay: 1600});
        hoverLines(ctx, F, [{name: 'Deutschschweiz', color: C(0), values: pts}], pts.map((d) => d.x), yr, minFmt);
      }
    },
    trend_regionen: {
      sources: ['tv_minuten_trend'],
      label: 'Liniendiagramm: Sehdauer der drei Sprachregionen von 1985 bis 2025',
      render(ctx) {
        const rows = ctx.data.tv_minuten_trend;
        const series = REGS.map((r) => ({name: r, color: C(RC[r]), values: rows.filter((d) => d.region === r).map((d) => ({x: +d.jahr, y: +d.minuten})).sort((a, b) => a.x - b.x)})).filter((s) => s.values.length);
        if (!series.length) return;
        const all = series.flatMap((s) => s.values);
        const ext = d3.extent(all, (d) => d.x);
        const right = d3.max(series, (s) => measure(ctx.svg, `${SHORT[s.name]} ${f1(s.values[s.values.length - 1].y)}`)) + 18;
        const F = frame(ctx, {x: d3.scaleLinear().domain(ext), yMax: d3.max(all, (d) => d.y) * 1.25, yFmt: f0, xTicks: yearTicks(ext[0], ext[1], ctx.w - 60 - right), xFmt: yr, right});
        refLineX(F, 2013);
        series.forEach((s, i) => drawLine(F, s.values, s.color, {animate: ctx.animate, delay: i * 250}));
        endLabels(F, series.map((s) => { const l = s.values[s.values.length - 1]; return {y: F.y(l.y), color: s.color, text: `${SHORT[s.name]} ${f1(l.y)}`}; }));
        const it = series.find((s) => s.name === 'Svizzera italiana');
        if (it) {
          const m = it.values.reduce((a, b) => (b.y > a.y ? b : a));
          annot(ctx, F, {x: F.x(m.x), y: F.y(m.y), tx: F.x(m.x) - 10, ty: F.y(m.y) - 50, anchor: 'end', lines: [`Svizzera italiana, ${m.x}`, `Spitze: ${f1(m.y)} Min.`], delay: 1300});
        }
        hoverLines(ctx, F, series, Array.from(new Set(all.map((d) => d.x))).sort((a, b) => a - b), yr, minFmt);
      }
    },
    komposition: {
      sources: ['tv_set_anteile'],
      label: 'Gestapelte Säulen: Minuten mit und ohne Senderzuordnung 2013 bis 2025, Deutschschweiz',
      render(ctx) {
        const rows = ctx.data.tv_set_anteile.filter((r) => r.region === 'Deutschschweiz').map((r) => ({jahr: +r.jahr, s: +r.sender_minuten, n: +r.nicht_sender_minuten, t: +r.total_minuten, p: +r.nicht_sender_pct})).sort((a, b) => a.jahr - b.jahr);
        if (!rows.length) return;
        const top = legend(ctx, [{label: 'Sender (live und zeitversetzt)', color: C(0), bar: true}, {label: 'Ohne Senderzuordnung', color: C(4), bar: true}]) + 34;
        const years = rows.map((r) => r.jahr);
        const xb = d3.scaleBand().domain(years).padding(0.25);
        const F = frame(ctx, {x: xb, yMax: d3.max(rows, (r) => r.t) * 1.2, yFmt: f0, top, xTicks: years.filter((y, i) => ctx.w > 520 || i % 3 === 0 || i === years.length - 1), xFmt: yr});
        const bw = xb.bandwidth();
        const g = F.gp.append('g');
        rows.forEach((r, i) => {
