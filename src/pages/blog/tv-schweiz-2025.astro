          const b1 = g.append('rect').attr('x', gx).attr('width', bw).style('fill', C(0)).attr('rx', 1.5);
          const b2 = g.append('rect').attr('x', gx).attr('width', bw).style('fill', C(4)).attr('rx', 1.5);
          const set = (sel, y, hgt) => sel.attr('y', y).attr('height', Math.max(0, hgt));
          if (ctx.animate) {
            set(b1, F.ih, 0); set(b2, F.y(r.s), 0);
            b1.transition().delay(i * 50).duration(600).ease(d3.easeCubicOut).attr('y', F.y(r.s)).attr('height', F.ih - F.y(r.s));
