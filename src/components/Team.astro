---
import { Image } from "astro:assets";
import { team } from "../data/site";
---

<section
  id="team"
  class="relative bg-[var(--color-background)] px-6 py-28 md:py-36"
>
  <div class="mx-auto max-w-6xl">
    <h2
      class="mb-16 max-w-[22ch] font-serif leading-[1.05]"
      style="font-size: var(--text-display-lg);"
    >
      {team.title}
    </h2>

    <div class="grid gap-x-8 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
      {
        team.members.map((member) => (
          <article class="group flex flex-col">
            <div class="mb-6 overflow-hidden rounded-[var(--radius-card)] bg-[var(--color-surface)]">
              <Image
                src={member.photo}
                alt={member.name}
                width={600}
                height={750}
                class="aspect-[4/5] w-full object-cover opacity-80 grayscale transition-all duration-700 ease-out group-hover:scale-[1.02] group-hover:opacity-100 group-hover:grayscale-0"
              />
            </div>
            <h3
              class="mb-1 font-serif text-[var(--color-ink)]"
              style="font-size: 1.5rem;"
            >
              {member.name}
            </h3>
            <p class="mb-3 font-sans text-sm tracking-[0.08em] text-[var(--color-accent)]">
              {member.role}
            </p>
            <p class="font-sans text-[15px] leading-relaxed text-[var(--color-ink-muted)]">
              {member.desc}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
