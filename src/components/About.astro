---
import { aboutDataPeople } from "../data/site";
---

<section
  id="about"
  class="relative bg-[var(--color-muted)] px-6 py-28 md:py-36"
>
  <div class="mx-auto max-w-6xl">
    <p
      class="mb-4 font-sans text-sm uppercase tracking-[0.18em] text-[var(--color-ink-muted)]"
    >
      {aboutDataPeople.kicker}
    </p>
    <h2
      class="mb-12 max-w-[18ch] font-serif leading-[1.05]"
      style="font-size: var(--text-display-lg);"
    >
      {aboutDataPeople.title}
    </h2>

    <div class="grid gap-16 md:grid-cols-[1fr_1.4fr]">
      <p class="font-sans text-lg leading-relaxed text-[var(--color-ink-muted)]">
        {aboutDataPeople.intro}
      </p>

      <ul class="flex flex-col">
        {aboutDataPeople.points.map((point, i) => (
          <li
            class="grid grid-cols-[3rem_1fr] gap-6 border-t border-[var(--color-rule)] py-10"
          >
            <span
              class="font-serif text-2xl text-[var(--color-accent)] tabular-nums"
            >
              {String(i + 1).padStart(2, "0")}
            </span>
            <div>
              <h3
                class="mb-3 font-serif leading-[1.15] text-[var(--color-ink)]"
                style="font-size: 1.5rem;"
              >
                {point.title}
              </h3>
              <p class="font-sans text-base leading-relaxed text-[var(--color-ink-muted)]">
                {point.desc}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
