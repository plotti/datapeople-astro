---
import { nav } from "../data/site";

const links = [
  { href: "/#about", label: nav.about, id: "about" },
  { href: "/#services", label: nav.services, id: "services" },
  { href: "/#advantages", label: nav.howItWorks, id: "advantages" },
  { href: "/#team", label: nav.team, id: "team" },
  { href: "/blog/", label: nav.blog, id: "blog" },
  { href: "/blog/ai-agent-tooling-landscape/", label: nav.aiOverview, id: "ai-overview" },
];
---

<nav
  aria-label="Primary"
  class="sticky top-0 z-40 w-full border-b border-[var(--color-rule)] bg-[color-mix(in_oklab,var(--color-background)_92%,transparent)] backdrop-blur-[2px]"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a
      href="/"
      class="font-serif text-[22px] leading-none text-[var(--color-ink)]"
      style="letter-spacing: var(--tracking-wordmark);"
      >datapeople<em class="italic text-[var(--color-accent)]">.</em></a
    >

    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-section={link.id}
            data-navigation-link
            class="nav-link relative inline-block py-2 text-sm text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-3">
      <a
        href="/#contact"
        data-navigation-cta
        class="hidden items-center rounded-full bg-[var(--color-ink)] px-5 py-3 text-sm font-medium text-[var(--color-background)] transition-transform duration-300 ease-out hover:-translate-y-px md:inline-flex"
      >
        {nav.cta}
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menü öffnen"
        class="-mr-2 flex h-11 w-11 items-center justify-center md:hidden"
      >
        <span class="burger" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" data-menu-panel hidden class="border-t border-[var(--color-rule)] md:hidden">
    <div class="mx-auto flex max-w-6xl flex-col px-6 py-4">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-section={link.id}
            data-navigation-link
            class="border-b border-[var(--color-muted)] py-3.5 text-base text-[var(--color-ink-muted)] transition-colors last:border-b-0 hover:text-[var(--color-ink)]"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/#contact"
        data-navigation-cta
        class="mt-4 inline-flex items-center justify-center rounded-full bg-[var(--color-ink)] px-5 py-3.5 text-sm font-medium text-[var(--color-background)]"
      >
        {nav.cta}
      </a>
    </div>
  </div>
</nav>

<style>
  .nav-link.is-active {
    color: var(--color-ink);
  }
  .nav-link.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1.05rem;
    height: 2px;
    background: var(--color-accent);
  }

  /* Burger icon — three lines, morphs to an X when open */
  .burger {
    position: relative;
    display: block;
    width: 22px;
    height: 22px;
  }
  .burger > span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: var(--color-ink);
    transition:
      top 0.25s ease,
      transform 0.25s ease,
      opacity 0.2s ease;
  }
  .burger > span:nth-child(1) {
    top: 5px;
  }
  .burger > span:nth-child(2) {
    top: 10px;
  }
  .burger > span:nth-child(3) {
    top: 15px;
  }
  button[aria-expanded="true"] .burger > span:nth-child(1) {
    top: 10px;
    transform: rotate(45deg);
  }
  button[aria-expanded="true"] .burger > span:nth-child(2) {
    opacity: 0;
  }
  button[aria-expanded="true"] .burger > span:nth-child(3) {
    top: 10px;
    transform: rotate(-45deg);
  }

  /* Dropdown slides in on open (animation replays whenever hidden is removed) */
  [data-menu-panel]:not([hidden]) {
    animation: menu-in 0.2s ease;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  /*
    Active-section highlighting in the navbar.
    Watches each section the nav links to, and marks the most-visible one.
  */
  const links = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
  const sections = Array.from(links)
    .map((link) => {
      const id = link.dataset.section;
      return id ? document.getElementById(id) : null;
    })
    .filter((s): s is HTMLElement => s !== null);

  const setActive = (id: string) => {
    links.forEach((link) => {
      link.classList.toggle("is-active", link.dataset.section === id);
    });
  };

  if (sections.length > 0 && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setActive(visible.target.id);
      },
      { rootMargin: "-40% 0px -50% 0px", threshold: [0, 0.25, 0.5, 0.75, 1] }
    );
    sections.forEach((s) => observer.observe(s));
  }

  /*
    Mobile burger menu.
    Opens the dropdown panel, morphs the icon to an X, and closes again on
    link click, Escape, or when the viewport grows past the md breakpoint.
  */
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.getElementById("mobile-menu");

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Menü schliessen" : "Menü öffnen");
      panel.hidden = !open;
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    panel.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    const desktop = window.matchMedia("(min-width: 768px)");
    desktop.addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<script is:inline>
  document.querySelectorAll("[data-navigation-link]").forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("navigation_link_clicked", {
        destination_section: link.getAttribute("data-section"),
        link_location: "primary_navigation",
      });
    });
  });

  document.querySelectorAll("[data-navigation-cta]").forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("consultation_cta_clicked", {
        cta_location: "primary_navigation",
        target_section: "contact",
      });
    });
  });
</script>
