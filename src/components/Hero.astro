---
import { hero } from "../data/site";

/*
  Hero — fullpage (min-h 100dvh, content vertikal zentriert).
  Beide Zeilen in Spectral. Ein Wort in Zeile 2 trägt den Italic-Accent
  (Brand-Regel: "Ein Wort pro Überschrift darf kursiv und Akzent sein").
*/
---

<section
  class="relative flex min-h-[100dvh] items-center px-6 py-16 md:py-20"
>
  <div class="mx-auto w-full max-w-6xl">
    <h1 class="mb-8 text-[color:var(--color-ink)] font-serif">
      <span
        class="block font-normal leading-[0.98]"
        style="font-size: var(--text-display-xl);"
      >
        {hero.line1}
      </span>
      <span
        class="mt-1 block leading-[1.0]"
        style="font-size: var(--text-display-xl);"
      >
        {hero.line2.before}<em class="italic text-[var(--color-accent)]"
          >{hero.line2.emphasis}</em
        >{hero.line2.after}
      </span>
    </h1>

    <p
      class="mb-10 max-w-[52ch] font-sans text-lg leading-relaxed text-[var(--color-ink-muted)] md:text-xl"
    >
      {hero.sub}
    </p>

    <div class="flex flex-wrap items-center gap-6">
      <a
        href="#contact"
        class="inline-flex items-center rounded-full bg-[var(--color-ink)] px-8 py-4 text-base font-medium text-[var(--color-background)] transition-transform duration-300 ease-out hover:-translate-y-px"
      >
        {hero.primaryCta}
      </a>
      <a
        href="#how-it-works"
        class="inline-flex items-center py-2 font-sans text-base text-[var(--color-ink-muted)] underline-offset-4 transition-colors hover:text-[var(--color-ink)] hover:underline"
      >
        {hero.secondaryCta}
        <span aria-hidden="true" class="ml-2">→</span>
      </a>
    </div>
  </div>
</section>
